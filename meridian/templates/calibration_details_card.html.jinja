<card id="calibration-details" class="calibration-details-card">
  <card-title>
    Calibration details
  </card-title>

  <div class="plots-section">
    <infos>
      <infos-icon>
        <img src="https://www.gstatic.com/images/icons/material/system/svg/info_outline_24px.svg"
              alt="info icon" />
      </infos-icon>
      <p class="info-text">{{ details_description | safe }}</p>
    </infos>

    {% for ch in plotted_channels %}
      <div class="plot-container">
        <div id="calibration-details-chart-{{ ch.chart_id }}"></div>
      </div>
    {% endfor %}
  </div>
</card>

<script type="text/javascript">
  (() => {
    {% for ch in plotted_channels %}
      {% if ch.chart_json %}
        const spec_{{ ch.chart_id }} = JSON.parse({{ ch.chart_json|tojson }});
        vegaEmbed('#calibration-details-chart-{{ ch.chart_id }}', spec_{{ ch.chart_id }}).catch(console.error);
      {% endif %}
    {% endfor %}
  })();
</script>
